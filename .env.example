# Database
# Runtime connection — use the non-owner taxpro_app role with NOBYPASSRLS
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taxpro
# Migration connection — use the schema owner role (e.g. postgres or taxpro_migrations)
DATABASE_URL_MIGRATIONS=postgres://postgres:postgres@localhost:5432/taxpro

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
DATA_ENCRYPTION_KEY=change-me-to-a-32-character-secret
CORS_ORIGIN=http://localhost:5173

# ── AI Provider ──────────────────────────────────────
# Pick one:
#   openai → AI_BASE_URL=https://api.openai.com/v1,  AI_MODEL=gpt-4o-mini
#   nvidia → AI_BASE_URL=https://integrate.api.nvidia.com/v1,  AI_MODEL=z-ai/glm-5.2
#   custom → set your own base URL + model name
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Legacy fallback if AI_API_KEY is empty
OPENAI_API_KEY=sk-...

# NetSuite OAuth (default sandbox — override per connection)
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_REALM=
NETSUITE_BASE_URL=

# Companies House (for UK benchmark harness)
# Get a free API key at https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# Server
PORT=3001
NODE_ENV=development
